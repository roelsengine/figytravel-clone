                  "display": "inline-block",
                  "margin-bottom": "16px",
                  "background-image": "linear-gradient(90deg, @text_1, @text_2 80%)",
                  "-webkit-background-clip": "text",
                  "-webkit-text-fill-color": "transparent"
                }
              },
              ".title-wrapper": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "22px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "0"
                },
                ".mbr-section-subtitle": {
                  "margin-bottom": "0",
                  "background-image": "linear-gradient(90deg, @text_1, @text_2 60%)",
                  "-webkit-background-clip": "text",
                  "-webkit-text-fill-color": "transparent"
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "70%",
