        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 1440px)": {
                  "padding": "0 36px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "fit-content",
              "max-width": "fit-content",
              "@media (max-width: 767px)": {
                "min-width": "fit-content",
                "max-width": "fit-content"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".card-box": {
                    ".card-title": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "32px",
              "height": "32px",
              "margin-top": "-1.5rem",
              "font-size": "26px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "none",
              "border-radius": "0",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "color": "@successColor !important"
              },
              "&.embla__button--prev": {
                "right": "6rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "4rem"
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".card-title": {
              "color": "#080808"
            }
          },
          "_name": "slider03",
          "_sourceTheme": "resumem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider03 mbr-embla resumem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"2\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f0f0f0\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f0f0f0\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\">\n                                                Design portfolio ↗\n                                            </h4>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\">\n                                                Design portfolio ↗\n                                            </h4>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\">\n                                                Design portfolio ↗\n                                            </h4>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\">\n                                                Design portfolio ↗\n                                            </h4>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\">\n                                                Design portfolio ↗\n                                            </h4>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSgYdrhDvL",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-9t"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "width": "100%",
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "margin-bottom": "2rem"
            },
            "@media (max-width: 767px)": {
              ".item": {
                "margin-bottom": "1rem"
              }
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-content": {
              "margin-top": "2rem",
              "padding": "0 2.25rem 2.25rem",
              "@media (min-width: 992px) and (max-width: 1200px)": {
                "padding": "2rem 1.5rem",
                "padding-top": "1rem",
                "margin-top": "1rem"
              },
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem",
                "padding-top": "1rem",
                "margin-top": "1rem"
              },
              "display": "flex",
              "flex-direction": "column",
              "height": "100%"
            },
            ".item-wrapper": {
              "position": "relative",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              ".item-footer": {
                "margin-top": "auto"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-title": {
              "text-align": "left"
            },
            ".item-subtitle": {
              "text-align": "left"
            },
            ".mbr-text, .item .mbr-section-btn": {
              "text-align": "left"
            },
            ".content-head": {
              "max-width": "800px"
            }
          },
          "_name": "pricing02",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\n  class=\"pricing02\"\n  group=\"Pricing\"\n  mbr-class=\"{'mbr-parallax-background': bg.parallax}\"\n>\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    <select title=\"Columns\" name=\"cardsWidth\">\n      <option value=\"12\">1</option>\n      <option value=\"6\">2</option>\n      <option value=\"4\" selected>3</option>\n      <option value=\"3\">4</option>\n    </select>\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n    <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n    <input type=\"checkbox\" name=\"showmainButtons\" title=\"Buttons\">\n    <header>Cards</header>\n    <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n    <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\"\n      condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n    <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n    <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n    <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Price\" checked>\n    <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n    <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n    <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#ffffff\">\n    <header>Background</header>\n    <fieldset type=\"background\" parallax name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#edefeb\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n      condition=\"overlay && bg.type == 'image'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n      condition=\"overlay && bg.type == 'image'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n      <div class=\"col-12 content-head\">\n        <div class=\"mbr-section-head mb-5\" mbr-if=\"showTitle || showSubtitle || showmainButton\">\n          <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\n            data-app-selector=\".mbr-section-title\">\n            <b>Our Products</b>\n          </h4>\n          <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\"\n            mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .mbr-section-head .mbr-section-btn\">\n            Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n          </h5>\n          <div class=\"mbr-section-btn align-center item-footer mb-0 mt-4\" mbr-if=\"showmainButtons\"\n            data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n            <a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Get Started</a>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n        <div class=\"item-wrapper\">\n          <div class=\"item-img\">\n            <img src=\"../_images/shop/shop1.jpg\" alt=\"Mobirise Website Builder\">\n          </div>\n          <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n            <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\"\n              mbr-if=\"showCardTitle\">\n              <b>Marketing</b>\n            </h5>\n            <h6 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\"\n              mbr-if=\"showCardSubtitle\">\n              $5.00\n            </h6>\n            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"\n              data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit habitant turpis.\n            </p>\n            <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"\n              mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\"\n                data-app-placeholder=\"Type Text\">Buy Now</a></div>\n          </div>\n\n        </div>\n      </div>\n      <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n        <div class=\"item-wrapper\">\n          <div class=\"item-img\">\n            <img src=\"../_images/shop/shop2.jpg\" alt=\"Mobirise Website Builder\">\n          </div>\n          <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n            <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\"\n              mbr-if=\"showCardTitle\">\n              <b>Promotion</b>\n            </h5>\n            <h6 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\"\n              mbr-if=\"showCardSubtitle\">\n              $7.00\n            </h6>\n            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"\n              data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit habitant turpis.\n            </p>\n            <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"\n              mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\"\n                data-app-placeholder=\"Type Text\">Buy Now</a></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n        <div class=\"item-wrapper\">\n          <div class=\"item-img\">\n            <img src=\"../_images/shop/shop3.jpg\" alt=\"Mobirise Website Builder\">\n          </div>\n          <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n            <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\"\n              mbr-if=\"showCardTitle\">\n              <b>Branding</b>\n            </h5>\n            <h6 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\"\n              mbr-if=\"showCardSubtitle\">\n              $10.00\n            </h6>\n            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"\n              data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit habitant turpis.<br>\n            </p>\n            <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"\n              mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\"\n                data-app-placeholder=\"Type Text\">Buy Now</a></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "uSgWLkxanh",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "pricing02-9m"
        },
        {
          "_name": "pricing2",
          "_sourceTheme": "marketm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing2 marketm4_pricing2\" group=\"Pricing Tables\"\n\tdata-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" >\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" >\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked >\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked >\n\t\t<header>Card</header>\n\t\t<select name=\"itemCount\" title=\"Card Amount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitleCard\" checked >\n\t\t<input type=\"checkbox\" title=\"Price\" name=\"showPriceCard\" checked >\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked >\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"cardText\" checked >\n\t\t<input type=\"checkbox\" title=\"Icon\" name=\"cardIcon\" checked >\n\t\t<input type=\"color\" title=\"Color Icon\" value=\"#ebeaed\" name=\"bgColorIcon\" condition=\"cardIcon\" >\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/marketm4/components/_images/bg1.jpg\" parallax >\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected >\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" >\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/marketm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" >\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#2f1893\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container text-center\">\n\t\t<p class=\"mbr-text ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\"\n\t\t\tmbr-if=\"showText\">PRICING PLAN</p>\n\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"\n\t\t\tdata-app-selector=\".mbr-section-title\">\n\t\t\tClear &amp; Simple\n\t\t</h2>\n\t\t<div class=\"row justify-content-center no-gutters\">\n\t\t\t<div class=\"col-xl-10\">\n\t\t\t\t<div class=\"row justify-content-lg-center\">\n\t\t\t\t\t<div class=\"col-lg-3 col-md-5 col-sm-6 mb-lg-0 card__wrapper\">\n\t\t\t\t\t\t<p class=\"title__card mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\tdata-app-selector=\".title__card\" mbr-if=\"showTitleCard\">\n\t\t\t\t\t\t\tFree\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p class=\"price__card mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".price__card\" mbr-if=\"showPriceCard\">\n\t\t\t\t\t\t\t$0/month\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"mx-auto icons\" mbr-if=\"cardIcon\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-star fa\"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"\n\t\t\t\t\t\t\tdata-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-md btn-warning-outline\" href=\"https://mobiri.se\"\n\t\t\t\t\t\t\t\tdata-app-placeholder=\"Type Text\">Get Start</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".card__text\" mbr-if=\"cardText\">\n\t\t\t\t\t\t\t5 products<br>Unlimited support<br>125 emails\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-lg-3 col-md-5 col-sm-6 mb-lg-0 card__wrapper\" mbr-if=\"itemCount > 1\">\n\t\t\t\t\t\t<p class=\"title__card mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\tdata-app-selector=\".title__card\" mbr-if=\"showTitleCard\">\n\t\t\t\t\t\t\tStandart\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p class=\"price__card mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".price__card\" mbr-if=\"showPriceCard\">\n\t\t\t\t\t\t\t$19.99/month\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"mx-auto icons\" mbr-if=\"cardIcon\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-crosshairs fa\"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"\n\t\t\t\t\t\t\tdata-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-md btn-warning-outline\" href=\"https://mobiri.se\"\n\t\t\t\t\t\t\t\tdata-app-placeholder=\"Type Text\">Get Start</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".card__text\" mbr-if=\"cardText\">\n\t\t\t\t\t\t\t15 products<br>\n\t\t\t\t\t\t\tUnlimited support<br>\n\t\t\t\t\t\t\t300 emails<br>Skype support <br>Easy form service<br>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-lg-3 col-md-5 col-sm-6 mb-lg-0 card__wrapper\" mbr-if=\"itemCount > 2\">\n\t\t\t\t\t\t<p class=\"title__card mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\tdata-app-selector=\".title__card\" mbr-if=\"showTitleCard\">\n\t\t\t\t\t\t\tPremium\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p class=\"price__card mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".price__card\" mbr-if=\"showPriceCard\">\n\t\t\t\t\t\t\t$29.99/month\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"mx-auto icons\" mbr-if=\"cardIcon\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-bomb fa\"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"\n\t\t\t\t\t\t\tdata-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-md btn-warning-outline\" href=\"https://mobiri.se\"\n\t\t\t\t\t\t\t\tdata-app-placeholder=\"Type Text\">Get Start</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".card__text\" mbr-if=\"cardText\">\n\t\t\t\t\t\t\t25 products<br>Unlimited support <br>Unlimited emails <br>Skype support <br>Easy\n\t\t\t\t\t\t\tform service<br>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-lg-3 col-md-5 col-sm-6 mb-lg-0 card__wrapper\" mbr-if=\"itemCount > 3\">\n\t\t\t\t\t\t<p class=\"title__card mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\tdata-app-selector=\".title__card\" mbr-if=\"showTitleCard\">\n\t\t\t\t\t\t\tBusiness\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p class=\"price__card mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".price__card\" mbr-if=\"showPriceCard\">\n\t\t\t\t\t\t\t$49.99/month\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<div class=\"mx-auto icons\" mbr-if=\"cardIcon\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-building fa\"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"\n\t\t\t\t\t\t\tdata-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t\t<a class=\"btn btn-md btn-warning-outline\" href=\"https://mobiri.se\"\n\t\t\t\t\t\t\t\tdata-app-placeholder=\"Type Text\">Get Start</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\tdata-app-selector=\".card__text\" mbr-if=\"cardText\">\n\t\t\t\t\t\t\t35 products <br>Unlimited support <br>Unlimited emails <br>Skype support <br>Easy\n\t\t\t\t\t\t\tform service<br>500 business\n\t\t\t\t\t\t\tcards<br>Social network tool\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
