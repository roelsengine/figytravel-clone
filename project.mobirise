              }
            },
            ".carousel-control:hover": {
              "color": "@primaryColor"
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            "@media (min-width: 990px)": {
              ".mobi-mbri-arrow-next": {
                "margin-left": "-50px"
              },
              ".mobi-mbri-arrow-prev": {
                "margin-right": "-50px"
              }
            },
            ".carousel-indicators": {
              "display": "none"
            },
            ".text-content": {
              "width": "100%"
            },
            ".left-side": {
              "text-align": "left"
            },
            ".row": {
              "align-items": "center"
            },
            "@media (max-width: 600px)": {
