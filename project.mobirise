        {
          "_name": "team4",
          "_sourceTheme": "petsm4",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Teams\" class=\"team4 petsm4_team4\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n\tmbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"5\" step=\"1\" value=\"1\"\n\t\t\tcondition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"5\" step=\"1\" value=\"1\"\n\t\t\tcondition=\"fullScreen == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showsubTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Col Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n\t\t<input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#383838\" selected>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/petsm4/components/_images/background2.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/petsm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n\t\tbg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-md-12 col-lg-7 img-col\">\n\t\t\t\t<div class=\"mbr-figure\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/07.webp\" alt=\"Mobirise\">\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-md-12 content py-4 col-lg-5 \">\n\t\t\t\t<h1 class=\"mbr-section-title align-left mbr-bold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-2\"\n\t\t\t\t\tmbr-if=\"showTitle\"><b><a href=\"#\"><b>Robert</b></a> </b>Sallivan\n\t\t\t\t</h1>\n\t\t\t\t<p class=\"align-left mbr-regular pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\tmbr-if=\"showsubTitle\">\n\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Sed ac feugiat neque. Nulla gravida sodales\n\t\t\t\t\tenim at interdum. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac\n\t\t\t\t\tturpis egestas.</p>\n\n\t\t\t\t<div class=\"icons-wrap row\">\n\t\t\t\t\t<div class=\"icon-wrap align-left col-md-4\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbrib-globe  \" mbr-if=\"showIcons\"></span>\n\t\t\t\t\t\t<div class=\"text-wrap\" mbr-if=\"showText\">\n\t\t\t\t\t\t\t<h3 class=\"icon-title align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\t\tdata-app-selector=\".icon-title, .icon-wrap\">DOG CARE</h3>\n\t\t\t\t\t\t\t<p class=\"mbr-text mbr-regular align-left mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\tmbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .content\"> Lorem\n\t\t\t\t\t\t\t\tipsum dolor amet, consectetur adipiscing elit.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"icon-wrap align-left col-md-4\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbrib-alert  \" mbr-if=\"showIcons\"></span>\n\t\t\t\t\t\t<div class=\"text-wrap\" mbr-if=\"showText\">\n\t\t\t\t\t\t\t<h3 class=\"icon-title align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\t\tdata-app-selector=\".icon-title, .mbr-iconfont\">TRAINING</h3>\n\t\t\t\t\t\t\t<p class=\"mbr-text mbr-regular align-left mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\tmbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .content\"> Lorem ipsum\n\t\t\t\t\t\t\t\tdolor amet, consectetur adipiscing elit.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"icon-wrap align-left col-md-4\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbrib-hearth  \" mbr-if=\"showIcons\"></span>\n\t\t\t\t\t\t<div class=\"text-wrap\" mbr-if=\"showText\">\n\t\t\t\t\t\t\t<h3 class=\"icon-title align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\t\tdata-app-selector=\".icon-title, .mbr-iconfont\">FIRST AID</h3>\n\t\t\t\t\t\t\t<p class=\"mbr-text mbr-regular align-left mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\tmbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .content\"> Lorem ipsum\n\t\t\t\t\t\t\t\tdolor amet, consectetur adipiscing elit.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".content": {
              "@media (min-width: 992px)": {
                "max-width": "550px",
                "margin": "auto 0"
              },
              "@media (min-width: 767px)": {
                "padding": "0 2rem"
              }
            },
            ".row": {
              "-webkit-box-pack": "start",
              "justify-content": "flex-start"
            },
            ".img-col": {
              "padding": "0"
            },
            ".align-wrap": {
              "width": "fit-content",
              "display": "inline-block"
            },
            ".mbr-iconfont": {
              "font-size": "3rem",
              "color": "@iconColor !important",
              "padding-bottom": "1.5rem",
              "display": "block"
            },
            ".icon-title, .icon-wrap": {
              "color": "#ed6436"
            },
            ".mbr-text, .mbr-section-btn, .content": {
              "color": "#181818"
            },
            "@media (max-width: 992px)": {
              ".content": {
                "margin": "auto"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
