        {
          "_name": "pricing2",
          "_sourceTheme": "creatorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing2\" group=\"Pricing\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <header>Items</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButton\" checked>\n        <input type=\"color\" title=\"Card BG\" name=\"card\" value=\"#ffe33a\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/creatorm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a7a90\"\n               condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\"\n               condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n         mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h3 class=\"mbr-section-title mbr-fonts-style mbr-info\" mbr-if=\"showTitle\" mbr-theme-style=\"display-1\"\n            data-app-selector=\".mbr-section-title, .button-align\"><b>Exclusive content</b></h3>\n        <div class=\"row\">\n            <div class=\"col-12 col-md-6 col-lg-4 item features-image\">\n                <div class=\"shadow item-wrapper\">\n                    <div class=\"wrap-img item-img\">\n                        <div class=\"wrap-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image4.webp\" class=\"inner\">\n                        </div>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <h5 class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                            data-app-selector=\".card-price\"><b>$10.00</b></h5>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                            data-app-selector=\".card-title\"><b>Silver</b></h5>\n                        <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                            data-app-selector=\".card-text\">\n                            Cras ultricies ligula sed magna dictum porta. Praesent sapien massa, convallis a\n                            pellentesque\n                            nec, egestas non nisi.</h5>\n                        <div class=\"mbr-section-btn\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove\" mbr-buttons\n                             mbr-theme-style=\"display-4\"><a class=\"btn btn-black\" href data-app-placeholder=\"Type Text\">Buy\n                            Now</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4 item features-image\">\n                <div class=\"shadow item-wrapper\">\n                    <div class=\"wrap-img item-img\">\n                        <div class=\"wrap-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image6.webp\" class=\"inner\">\n                        </div>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <h5 class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                            data-app-selector=\".card-price\"><b>$20.00</b></h5>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                            data-app-selector=\".card-title\"><b>Gold</b></h5>\n                        <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                            data-app-selector=\".card-text\">\n                            Cras ultricies ligula sed magna dictum porta. Praesent sapien massa, convallis a\n                            pellentesque\n                            nec, egestas non nisi.</h5>\n                        <div class=\"mbr-section-btn\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove\" mbr-buttons\n                             mbr-theme-style=\"display-4\"><a class=\"btn btn-black\" href data-app-placeholder=\"Type Text\">Buy\n                            Now</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4 item features-image\">\n                <div class=\"shadow item-wrapper\">\n                    <div class=\"wrap-img item-img\">\n                        <div class=\"wrap-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image14.webp\" class=\"inner\">\n                        </div>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <h5 class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                            data-app-selector=\".card-price\"><b>$30.00</b></h5>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                            data-app-selector=\".card-title\"><b>Platinum</b></h5>\n                        <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                            data-app-selector=\".card-text\">\n                            Cras ultricies ligula sed magna dictum porta. Praesent sapien massa, convallis a\n                            pellentesque\n                            nec, egestas non nisi.</h5>\n                        <div class=\"mbr-section-btn\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove\" mbr-buttons\n                             mbr-theme-style=\"display-4\"><a class=\"btn btn-black\" href data-app-placeholder=\"Type Text\">Buy\n                            Now</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
