            },
            ".card-title": {
              "color": "#000000",
              "margin": "0",
              "padding-bottom": "0.2rem"
            },
            ".card-img": {
              "border-radius": "100%",
              "height": "100%"
            },
            ".card-box": {
              "padding": "0rem"
            },
