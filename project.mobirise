        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<div>\n<table class=\"table\">\n  <thead>\n    <tr>\n      <th scope=\"col\">#</th>\n      <th scope=\"col\">Program fee</th>\n      <th scope=\"col\">Per day</th>\n      \n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th scope=\"row\">1 week</th>\n      <td>€ 343</td>\n      <td>€ 49/day</td>\n      \n    </tr>\n    <tr>\n      <th scope=\"row\">2 weeks</th>\n      <td>€ 686</td>\n      <td>€ 49/day</td>\n      \n    </tr>\n    <tr>\n      <th scope=\"row\">4 weeks</th>\n      <td>€ 1.344</td>\n      <td>€ 48/day</td>\n      \n    </tr>\n      <tr>\n      <th scope=\"row\">6 weeks</th>\n      <td>€ 1.974</td>\n    <td>€ 47/day</td>\n      \n    </tr>\n      <tr>\n      <th scope=\"row\">8 weeks</th>\n      <td>€ 2.576</td>\n      <td>€ 46/day</td>\n      \n    </tr>\n      <tr>\n      <th scope=\"row\">10 weeks</th>\n      <td>€ 3.150</td>\n      <td>€ 45/day</td>\n      \n    </tr>\n        <tr>\n      <th scope=\"row\">12 weeks</th>\n      <td>€ 3.780</td>\n      <td>€ 45/day</td>\n      \n    </tr>\n  </tbody>\n</table>\n</div>",
          "_customCSS": "\ndiv {\n  padding:20px 10% 20px 10% ;\n  color: #777;\n  //text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "startm5",
          "_anchor": "custom-html-5p",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<div class=\"row\" style=\"padding:20px 8% 20px 8%\">\n  <div class=\"col-sm-6\">\n    <div class=\"card\">\n      <div class=\"card-body\">\n      \n          <div><ul class=\"list-group list-group-light list-group-flush \">\n    <li class=\"list-group-item list-group-item-action\">\n        <span class=\"socicon-facebook socicon\"></span>\n        <strong>Included in price</strong></li>\n              \n  <li class=\"list-group-item list-group-item-action\">\n\t\t\t\t\t\t<span class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t 3 nice meals per day</li>\n  <li class=\"list-group-item\">Accommodation + all MLVF facilities</li>\n  <li class=\"list-group-item\">Transport from and to Mwanza Airport</li>\n      <li class=\"list-group-item\"><span class=\"p-4 mbr-iconfont mobi-mbri-wifi mobi-mbri\"></span>Wi-fi</li>\n    <li class=\"list-group-item\"><span class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>24/7 in-country support</li>\n    <li class=\"list-group-item\"><span class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>Room cleaning</li>\n    <li class=\"list-group-item\"><span class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>Laundry service</li>\n    <li class=\"list-group-item\"><span class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>Bikes</li>\n    <li class=\"list-group-item\">Particular add-ons / activities</li>\n</ul>\n</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-sm-6\">\n    <div class=\"card\">\n      <div class=\"card-body\">\n        <div><ul class=\"list-group list-group-dark list-group-flush\">\n            <li class=\"list-group-item list-group-item-action\"><strong>Excluded from price</strong></li>\n        <li class=\"list-group-item\">Flight ticket</li>\n        <li class=\"list-group-item\">VISA costs</li>\n        <li class=\"list-group-item\">Vaccination(s)</li>\n        <li class=\"list-group-item\">Malaria Medication</li>\n              <li class=\"list-group-item\">Tips or souvenirs</li>\n              <li class=\"list-group-item\">Alcoholic beverages</li>\n              <li class=\"list-group-item\">Personal guides</li>\n              <li class=\"list-group-item\">Add-ons such as Safari/Zanzibar </li>\n              \n      </ul>\n    </div>\n      </div>\n    </div>\n  </div>\n</div>",
          "_customCSS": "\n",
