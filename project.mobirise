          "_name": "article11",
          "_sourceTheme": "startm5",
          "_customHTML": "<p class=\"note note-light center\">\n      <strong>Note:</strong> Maak een lijst met activiteiten <strong>zanzibar etc</strong> Met fotos en beschrijvingen.\n    </p>",
          "_JSplaceholders": [],
