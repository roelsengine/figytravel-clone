          "_name": "gallery01",
          "_sourceTheme": "servicem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\n        class=\"gellery01 servicem5\"\n        group=\"Gallery & Slider\"\n        mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\"\n>\n    <mbr-parameters>\n        <header>Size</header>\n        <input\n                type=\"range\"\n                inline\n                title=\"Top\"\n                name=\"paddingTop\"\n                min=\"0\"\n                max=\"12\"\n                step=\"1\"\n                value=\"2\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Bottom\"\n                name=\"paddingBottom\"\n                min=\"0\"\n                max=\"12\"\n                step=\"1\"\n                value=\"2\"\n        />\n        <header>Animated Text Settings</header>\n        <select title=\"Font style\" name=\"linesTitle\">\n            <option value=\"title1\">Title 1</option>\n            <option value=\"title2\">Title 2</option>\n            <option value=\"title3\" selected>Title 3</option>\n        </select>\n        <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\"\n               inline=\"\" name=\"animatedLine1\"\n               value=\"WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                 · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                 · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\">\n        <input type=\"range\" inline title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.01\">\n        <select title=\"Direction\" name=\"direction\">\n            <option value=\"-1\" selected>Left</option>\n            <option value=\"1\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Content Color\" value=\"#f7fff7\" name=\"contentColor\" selected>\n<!--        <input type=\"color\" title=\"Content BG\" value=\"#050f0f\" name=\"container\" selected>-->\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\"/>\n            <input type=\"color\" title=\"Color\" value=\"#050f0f\" selected/>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input\n                type=\"image\"\n                title=\"Fallback Image\"\n                value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\"\n                name=\"fallBackImage\"\n                condition=\"bg.type === 'video'\"\n        />\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked/>\n        <input\n                type=\"color\"\n                title=\"Overlay Color\"\n                name=\"overlayColor\"\n                value=\"#ffd9c8\"\n                condition=\"overlay && bg.type !== 'color'\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Opacity\"\n                name=\"overlayOpacity\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.1\"\n                value=\"0.9\"\n                condition=\"overlay && bg.type !== 'color'\"\n        />\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div\n            class=\"mbr-overlay\"\n            mbr-if=\"overlay && bg.type !== 'color'\"\n            opacity=\"{{overlayOpacity}}\"\n            bg-color=\"{{overlayColor}}\"\n    ></div>\n\n    <div class=\"container-fluid\">\n        <div class=\"loop-container\">\n            <div class=\"item\"\n                 mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2', 'display-5':linesTitle=='title3'}\"\n                 data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n            </div>\n            <div class=\"item\"\n                 mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2', 'display-5':linesTitle=='title3'}\"\n                 data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uSgXEOzTKU",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "gallery01-9p"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background-image": "linear-gradient(100deg, @gradientColor_1 10%, @bg-value 50%, @gradientColor_2 110%)"
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer"
            },
            "& when not (@spacing)": {
              ".grid-container": {
                "grid-row-gap": "0"
              },
              ".grid-container-1, .grid-container-2": {
                "gap": "0"
              }
            },
            "& when (@spacing)": {
              ".grid-container": {
                "grid-row-gap": "20px"
              },
              ".grid-container-1, .grid-container-2": {
                "gap": "0 20px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "margin-bottom": "22px"
              },
              "color": "#ffffff",
              "text-align": "center"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".container, .container-fluid": {
              "overflow": "hidden"
            },
            ".grid-container": {
              "display": "grid",
              "transform": "translate3d(-3rem, 0, 0)",
              "width": "115vw",
              "grid-column-gap": "1rem"
            },
            ".grid-item": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center"
            },
            ".grid-item img": {
              "@media (max-width: 992px)": {
                "height": "350px"
              },
              "@media (max-width: 767px)": {
                "min-width": "35vw",
                "height": "150px"
              },
              "min-width": "30vw",
              "max-width": "100%",
              "height": "450px",
              "object-fit": "cover"
            },
            ".grid-container-1, .grid-container-2": {
              "display": "grid",
              "grid-template-columns": "repeat(4, 1fr)",
              "grid-auto-columns": "1fr",
              "grid-auto-flow": "column"
            },
            ".grid-container-1": {
              "align-items": "flex-end"
            },
            ".grid-container-2": {
              "align-items": "flex-start"
            }
          },
          "_name": "gallery02",
          "_sourceTheme": "emblemm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery02\" group=\"Gallery & Slider\" plugins=\"scrollGallery\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" />\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" />\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked />\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked />\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/emblemm5/components/_images/background1.jpg\" />\n            <input type=\"color\" title=\"Color\" value=\"#a78aff\" selected />\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Background\" name=\"gradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" title=\"Gradient Color 1\" name=\"gradientColor_1\" value=\"#000000\"\n               condition=\"gradientBg &&bg.type=='color'\">\n        <input type=\"color\" title=\"Gradient Color 2\" name=\"gradientColor_2\" value=\"#ff398a\"\n               condition=\"gradientBg &&bg.type=='color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" />\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#edefeb\"\n               condition=\"overlay && bg.type == 'image'\" />\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\"\n               condition=\"overlay && bg.type == 'image'\" />\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container-fluid gallery-wrapper\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"\n                        data-app-selector=\".mbr-section-title\">\n                        Publish your site or preview it to see how the slider works in action.\n                    </h4>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid-container\">\n            <div class=\"grid-container-1\" style=\"transform: translate3d(-200px, 0px, 0px);\">\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image22.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image21.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image6.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image7.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"grid-container-2\" style=\"transform: translate3d(-70px, 0px, 0px);\">\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image8.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image12.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image15.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image18.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSgXx7fg2b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "gallery02-9o"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".user": {
              "background": "@card",
              "border-radius": "2rem",
              "padding": "2rem"
            },
            ".user_image": {
              "@media (max-width: 767px)": {
                "flex-direction": "column",
                "align-items": "center"
              }
            },
            "@media (max-width: 767px)": {
              ".user": {
                "padding": "1rem"
              }
            },
            ".wrap": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "700px",
              "max-width": "700px",
              "@media (max-width: 768px)": {
                "min-width": "70%",
                "max-width": "initial",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "rgba(0, 0, 0, 0.5)",
              "color": "#fff",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "#000",
                "color": "rgba(255, 255, 255, 0.5)"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 768px)": {
                "top": "auto"
              }
            },
            ".img-wrapper": {
              "img": {
                "width": "80px",
                "height": "80px",
                "border-radius": "50%",
                "object-fit": "cover",
                "margin-right": "1.5rem",
                "@media (max-width: 767px)": {
                  "margin-right": "0rem",
                  "margin-bottom": "1rem"
                }
              }
            },
            ".iconfont-wrapper": {
              "margin-right": "0",
              "margin-left": "auto",
              "span": {
                "color": "@secondaryColor",
                "font-size": "1.3rem",
                "margin": "0 3px"
              },
              "@media (max-width: 767px)": {
                "margin": "auto",
                "margin-top": "1rem"
              }
            },
            "@media (max-width: 230px)": {
              ".user_image": {
                "width": "100%",
                "height": "auto"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".user_desk": {
              "color": "#353535"
            },
            "H3": {
              "text-align": "center"
            }
          },
          "_name": "people02",
          "_sourceTheme": "learnm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people2 mbr-embla\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" inline>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" name=\"card\" title=\"BG\" value=\"#ffffff\" selected>\n        <header>Slides</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Author Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Author Title\" name=\"showDesk\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/learnm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/learnm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"position-relative text-center\">\n        <h3 class=\"mb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Student Feedback</b></h3>\n\n        <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\">\n            <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                <div class=\"embla__container\">\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"user\">\n                            <div class=\"user_image d-flex\">\n                                <div class=\"img-wrapper position-relative\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/volunteer-eva-h-160x155.webp\" alt=\"Mobirise Website Builder\">\n                                </div>\n                                <div class=\"wrap\">\n                                    <div mbr-text class=\"user_name align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Eva H.</b></div>\n                                    <div mbr-text class=\"user_desk align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">\n                                        Volunteer/internship</div>\n                                </div>\n\n                                <div class=\"iconfont-wrapper d-flex\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n\n                                </div>\n\n                            </div>\n                            <div class=\"user_text mt-3\">\n                                <p class=\"mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\"><br><b>\"My trip to Tanzania has been one of my best experiences in life\"</b><br><br>\"I got the opportunity from my school to do my internship in another country, and I was really interested in Tanzania. Me and three other students were introduced to FIGY Travel and Stichting Support School Fees (SSF), and we felt an instant connection. So, in October 2022 we stayed at Mwanza Lake View Farm for three months! We  volunteered at the schools and visited a lot of places. Like a prison, some farms, Mwanza town, Juma island and many kinds of schools. We also did a lot of activities with the children from the school and from the neighborhood like games, puzzles, singing, dancing, sports, and we provided sexual education. This was a great experience, and I  learned a lot from it. The people of Tanzania are so welcoming and friendly, it was amazing to meet all the teachers, children, and residents. The people that work at the farm are also so super friendly, they made me feel at home during my stay, so that was really nice. I felt very grateful to meet all these wonderful people.\n<br>\n<br></p>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"user\">\n                            <div class=\"user_image d-flex\">\n                                <div class=\"img-wrapper position-relative\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/volunteer-kiki-k-160x166.webp\" alt=\"Mobirise Website Builder\">\n                                </div>\n                                <div class=\"wrap\">\n                                    <div mbr-text class=\"user_name align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                                        <b>Kikkie K</b></div>\n                                    <div mbr-text class=\"user_desk align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">\n                                        Volunteer/internship</div>\n                                </div>\n\n                                <div class=\"iconfont-wrapper d-flex\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n\n                                </div>\n\n                            </div>\n                            <div class=\"user_text mt-3\">\n                                <p class=\"mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\"><b>\"I would definitely recommend volunteering/doing an internship at this organization and I would love to come back again\"&nbsp;</b><br><br>For my pedagogy study internship, I came to Mwanza Lake View Farm in October 2022, where I stayed for three months. During these three months, I got to see a lot of the area and visited several schools. Some of these schools have already been renovated by FIGY's partner foundation: Stichting Support School Fees. This is a big step for the health and education of  children, but also for the teachers. Thanks to Baraka (the Tanzanian co-owner of SSF), I was able to visit these schools and the surrounding area because he brought me here with his van. Besides Baraka, many other people work at Mwanza Lake View Farm. Everyone is very friendly and they give you a warm feeling as soon as you arrive. A lot is arranged for you if you want to get out and about, but if you want to stay at the Farm, that's certainly not a punishment either; the farm is beautifully situated on Lake Victoria, has a small beach and is nicely decorated with plants, besides that, the cottages are also fully equipped.\n<br>I would definitely recommend volunteering/doing an internship at this organization and I would love to come back again.\n<br>\n<br><br></p>\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"user\">\n                            <div class=\"user_image d-flex\">\n                                <div class=\"img-wrapper position-relative\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/volunteer-dani-esquivel-160x143.webp\" alt=\"Volunteer Internship\">\n                                </div>\n                                <div class=\"wrap\">\n                                    <div mbr-text class=\"user_name align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                                        <b>Dani Esquivel</b></div>\n                                    <div mbr-text class=\"user_desk align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">\n                                        Volunteer/internship</div>\n                                </div>\n\n                                <div class=\"iconfont-wrapper d-flex\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n\n                                </div>\n\n                            </div>\n                            <div class=\"user_text mt-3\">\n                                <p class=\"mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\"><b>\"My trip to Tanzania has been one of my best experiences in life\"</b><br><br>\"My trip to Tanzania was one of my best experiences in my life. The people that work on the project, the lodge and it's surroundings are wonderful and they make sure that everything is perfect and volunteers feel safe all the time. The project itself is a life changing experience, surround by love, smiles and gratefulness. I recommend this to everyone, age doesn't matter, you just need to want it.\"<b>&nbsp;</b><br></p>\n                            </div>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <button class=\"embla__button embla__button--prev\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n            </button>\n            <button class=\"embla__button embla__button--next\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n            </button>\n        </div>\n    </div>\n</section>",
          "_cid": "uHe5hMcSff",
          "_anchor": "people02-k",
