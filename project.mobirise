          "_name": "article11",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article11\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n       <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"8\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">        \n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\">\n    </div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mt-0 mb-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>This program is ideal for</b></h3>\n                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mt-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Energetic volunteers who are looking to assist with basic education and child care for young children. No prior child care/teaching experience necessary.</h4>\n                <div class=\"mbr-section-btn align-center mt-4\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\">\n                    <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Learn more\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uIxv1hG5eb",
          "_anchor": "article11-4m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "flex-end"
            },
            ".image-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              "img": {
                "height": "680px",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
                  "height": "350px"
                }
              }
            },
            ".content-wrapper": {
              "padding-left": "54px",
              "@media (max-width: 1440px)": {
                "padding-left": "40px"
              },
              "@media (max-width: 992px)": {
                "padding-left": "0"
              },
              "& when (@reverseContent)": {
                "padding-left": "0",
                "padding-right": "54px",
                "@media (max-width: 1440px)": {
                  "padding-right": "40px"
                },
                "@media (max-width: 992px)": {
                  "padding-right": "0"
                }
              },
              ".label-wrapper": {
                ".label-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "margin-bottom": "30px",
                  ".mbr-label": {
                    "margin-bottom": "0"
                  },
                  ".mbr-iconfont": {
                    "font-size": "18px",
                    "margin-right": "12px",
                    "color": "@icon"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              },
              ".mbr-text": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#FFBE0D"
            },
            ".mbr-section-title": {
              "color": "#fff7ee"
            },
            ".mbr-text": {
              "color": "#232323"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#232323"
            }
          },
          "_name": "article06",
          "_sourceTheme": "recyclem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article06 recyclem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#00a3fa\" name=\"icon\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/recyclem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/recyclem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/mbr-703x469.webp\" alt=\"Mobirise Website Builder\" title>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-1\"></div>\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"content-wrapper\">\n                    <div class=\"label-wrapper\">\n                        <div class=\"label-wrap\" mbr-if=\"showLabel\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                Considerations\n                            </p>\n                        </div>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>Contributes to United Nations’ Sustainable Development Goal #4: Quality Education</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        More than half of all children and teens do not meet minimum proficiency standards in reading and mathematics. Quality education provides an opportunity to learn and grow in a safe environment and is key to preventing poverty, securing long-term employment and improving quality of life.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            View more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-1\"></div>\n        </div>\n    </div>\n</section>",
          "_cid": "uIxv1ibUY3",
          "_anchor": "article06-4n",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 1440px)": {
                  "padding": "0 36px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "padding": "64px",
              "background-color": "@container",
              "border-radius": "2em",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "border-radius": "2rem",
                "background-image": "linear-gradient(@over, @over)",
                "opacity": ".83",
                "pointer-events": "none"
              },
              "@media (max-width: 992px)": {
                "padding": "36px"
              },
              ".icon-wrapper": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "48px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                },
                "@media (max-width: 768px)": {
                  "margin-bottom": "16px"
                },
                ".mbr-iconfont": {
                  "display": "inline-flex",
                  "font-size": "144px",
                  "color": "@icon",
                  "@media (max-width: 992px)": {
                    "font-size": "80px"
                  }
                }
              },
              ".mbr-text": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "48px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              },
              ".person-wrapper": {
                "position": "relative",
                "z-index": "1",
                ".person-wrap": {
                  "display": "inline-flex",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".image-wrapper": {
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "width": "108px",
                    "height": "108px",
                    "min-width": "108px",
                    "border-radius": "100%",
                    "padding": "4px",
                    "background-image": "linear-gradient(135deg, @color_1, @color_2)",
                    "margin-right": "30px",
                    "@media (max-width: 992px)": {
                      "margin": "0 0 30px 0"
                    },
                    "img": {
                      "display": "inline-flex",
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover",
                      "border-radius": "100% !important",
                      "border": "4px solid @over"
                    },
                    "a": {
                      "width": "100%",
                      "height": "100%"
                    }
                  },
                  ".name-wrapper": {
                    "display": "block",
                    "&:hover, &:focus": {
                      ".mbr-name": {
                        "color": "@active"
                      },
                      ".mbr-role": {
                        "color": "@active"
                      }
                    },
                    ".mbr-name": {
                      "margin-bottom": "0",
                      "transition": "all 0.3s ease-in-out"
                    },
                    ".mbr-role": {
                      "margin-bottom": "0",
                      "transition": "all 0.3s ease-in-out"
                    }
                  }
                }
              }
            },
            ".mbr-text": {
              "color": "#f0f0f0"
            },
            ".mbr-name": {
              "color": "#cccccc"
            },
            ".mbr-role": {
              "color": "#cccccc"
            }
          },
          "_name": "article01",
          "_sourceTheme": "resumem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"article01 resumem5\"\r\n        group=\"Article\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#cccccc\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked/>\r\n        <input type=\"color\" title=\"Border Color 1\" value=\"#7179ef\" name=\"color_1\" condition=\"showImage\" selected/>\r\n        <input type=\"color\" title=\"Border Color 2\" value=\"#e26a69\" name=\"color_2\" condition=\"showImage\" selected/>\r\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked/>\r\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked/>\r\n        <input type=\"color\" title=\"Active Color\" value=\"#3898EC\" name=\"active\" condition=\"showName || showRole\"\r\n               selected/>\r\n        <input type=\"color\" title=\"Container BG\" value=\"#3898EC\" name=\"container\" selected/>\r\n        <input type=\"color\" title=\"Container Overlay\" value=\"#000000\" name=\"over\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#f0f0f0\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#f0f0f0\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"content-wrapper\">\r\n                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                    </div>\r\n                    <p class=\"mbr-text mbr-fonts-style\"\r\n                       data-app-selector=\".mbr-text, .icon-wrapper\"\r\n                       mbr-theme-style=\"display-5\" mbr-if=\"showText\">\r\n                        As web designers and developers, our craft lies in the delicate balance of aesthetics and\r\n                        functionality.\r\n                    </p>\r\n                    <div class=\"person-wrapper\">\r\n                        <div class=\"person-wrap\">\r\n                            <div class=\"image-wrapper\" mbr-if=\"showImage\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image12.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <a href=\"#\" class=\"name-wrapper\">\r\n                                <p class=\"mbr-name mbr-fonts-style\" data-app-selector=\".mbr-name, .person-wrapper\"\r\n                                   mbr-theme-style=\"display-5\" mbr-if=\"showName\">\r\n                                    Richard Thomas ↗\r\n                                </p>\r\n                                <p class=\"mbr-role mbr-fonts-style\" data-app-selector=\".mbr-role, .person-wrapper\"\r\n                                   mbr-theme-style=\"display-7\" mbr-if=\"showRole\">\r\n                                    Web Design Developer\r\n                                </p>\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uIxv1iJO88",
          "_anchor": "article01-4o",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article03",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"article03 printm5\"\r\n        group=\"Article\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/printm5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#BAAB99\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/printm5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 col-lg-8\">\r\n                <div class=\"text-wrapper\">\r\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\"\r\n                       data-app-selector=\".mbr-text, .mbr-section-btn\">\r\n                        <i>The main objective of the studio with visuals is to cultivate a dynamic and inclusive\r\n                            creative space where artists and visionaries can harness the power of visual expression to\r\n                            communicate, provoke thought, and inspire.</i>\r\n                    </p>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                         mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                           data-app-placeholder=\"Type Text\">\r\n                            VIEW PROJECT EXAMPLES\r\n                        </a>\r\n                        <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                           data-app-placeholder=\"Type Text\">\r\n                            CONTACT THE STUDIO\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
