            },
            "@media (min-width: 575px) and (max-width: 990px)": {
              ".card-wrapper": {
                "padding": "60px 30px 40px"
              }
            },
            "@media (max-width: 574px)": {
              ".card-wrapper": {
                "padding": "60px 30px 40px"
              }
            },
            "H3": {
              "color": "#14142b",
              "text-align": "center"
            },
            "img": {
              "width": "auto",
              "height": "70px"
            },
            ".card-wrapper": {
              "background-color": "@card",
              "padding": "37px 32px 43px"
            },
            ".mbr-iconfont": {
              "transition": "0.3s",
              "margin-right": "5px"
            },
            ".link-title": {
              "display": "inline-block"
            },
            ".episode": {
              "color": "#ffffff"
            },
            ".img-title": {
              "color": "#ffffff"
            },
            ".margin": {
              "margin-right": "14px"
            },
            ".button-align": {
              "margin-top": "56px",
              "text-align": "center"
            },
            ".mbr-section-btn": {
              "width": "auto",
              "display": "block",
              ".btn": {
                "display": "flex"
              }
            },
            "@media (max-width: 500px)": {
              ".margin": {
                "margin-right": "0",
                "margin-bottom": "20px"
              }
            },
            "@media (max-width: 550px)": {
              ".card-wrapper": {
                "padding": "24px 25px 34px 25px"
              }
            },
            "span, .number": {
              "transition": "0.35s"
            },
            ".item.features-image": {
              "margin-top": "30px"
            },
            ".item.features-image:nth-child(1)": {
              "margin-top": "0px"
            },
            ".item.features-image:nth-child(2)": {
              "margin-top": "0px"
            },
            ".item.features-image:nth-child(3)": {
              "margin-top": "0px"
            },
            "@media (max-width: 992px)": {
              ".item.features-image:nth-child(3)": {
