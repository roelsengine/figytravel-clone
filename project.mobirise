        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<section class=\" justify-content-center w-100\" style=\"padding: 0px 10% 0px 10%\">\n          <ul class=\"list-group list-group-light list-group-flush text-center\">\n              <li class=\"list-group-item\"><h2><strong>Job specification</strong></h2></li>\n        <li class=\"list-group-item \">Assisting in teaching</li>\n        <li class=\"list-group-item\">Caring for children</li>\n        <li class=\"list-group-item\">Organizing games and activities</li>\n        <li class=\"list-group-item\">Organize fun and educational activities for children.</li>\n              <li class=\"list-group-item\">Engaging with children</li>\n              <li class=\"list-group-item\">Performing other duties as needed</li>\n            \n\n      </ul>\n    </section>\n\n\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0px 10% 0px 10%;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 14px;\n  color: #777;\n}\nli {\n    font-size: 18px;\n    \n}\n\nul{\n    align:center;\n    \n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
          "alias": "code-editor",
