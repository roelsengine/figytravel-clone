        {
          "_name": "testimonials01",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"testimonials1 travelm4_testimonials1\" group=\"Testimonials\"\n\tdata-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" >\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" >\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\" selected>1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t</select>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showMaintitle\" >\n\t\t<input type=\"checkbox\" title=\"Name\" name=\"showTitle\" checked >\n\t\t<input type=\"checkbox\" title=\"Date\" name=\"showStatus\" checked >\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked >\n\t\t<input type=\"checkbox\" title=\"Star\" name=\"showcont\" checked >\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Card\" name=\"cardColor\" value=\"#ffffff\" >\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#c2c2c2\" >\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@ADDONS_PATH@/travelm4/components/_images/background1.jpg\" title=\"Image\" >\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected >\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\" >\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/travelm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked >\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-md-12\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style align-left\" mbr-theme-style=\"display-2\"\n\t\t\t\t\tmbr-if=\"showMaintitle\" data-app-selector=\".mbr-section-title\">\n\t\t\t\t\tTestimonials\n\t\t\t\t</h2>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row row-content justify-content-center\">\n\t\t\t<div class=\"card py-4 col-md-12\">\n\t\t\t\t<div class=\"row justify-content-center card-wrapper\">\n\t\t\t\t\t<div class=\"col-md-2 col-lg-1 col-sm-6 pb-4\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/face1.webp\" title >\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-md-10 col-lg-11 col-sm-12\">\n\t\t\t\t\t\t<div class=\"text-box\">\n\t\t\t\t\t\t\t<h4 class=\"card-title pb-2 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\"\n\t\t\t\t\t\t\t\tmbr-if=\"showTitle\" data-app-selector=\".card-title\">\n\t\t\t\t\t\t\t\tTom Wilson\n\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t<p class=\"mbr-text pb-3 mbr-fonts-style status mbr-normal\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\tdata-app-selector=\".status\" mbr-if=\"showStatus\">\n\t\t\t\t\t\t\t\tDecember 15, 2025 at 11:17 am\n\t\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\t\t<p class=\"mbr-text pb-4 mbr-fonts-style text mbr-normal\" mbr-theme-sty