            }
          },
          "_name": "list02",
          "_sourceTheme": "healthm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list02 healthm5\" group=\"List\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"color\" title=\"Card BG\" value=\"#fbfaf9\" name=\"card\" selected=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#EDECEB\" name=\"border\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/healthm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-without-image active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                    Sensors\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                    Sensors play a crucial role in health devices by collecting data on various\n                                    physiological parameters such as heart rate, blood pressure, body temperature,\n                                    oxygen saturation.\n                                </p>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                                <a href=\"\" class=\"btn item-btn btn-info\" data-app-placeholder=\"Type Text\">\n                                    Read More\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                    Biometric Identification\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                    Biometric technologies, including fingerprint scanners, facial recognition systems,\n                                    and iris scanners, are employed in health devices for secure user.\n                                </p>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                                <a href=\"\" class=\"btn item-btn btn-info\" data-app-placeholder=\"Type Text\">\n                                    Read More\n                                </a>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                    Wearable Technology\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                    Wearable devices such as fitness trackers, smartwatches, and smart clothing are\n                                    equipped with sensors to monitor vital signs, activity levels, sleep patterns,\n                                </p>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                                <a href=\"\" class=\"btn item-btn btn-info\" data-app-placeholder=\"Type Text\">\n                                    Read More\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                    Internet of Things\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                    The Internet of Things (IoT) enables the connectivity of various devices and sensors\n                                    to collect and exchange data over the internet.\n                                </p>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                                <a href=\"\" class=\"btn item-btn btn-info\" data-app-placeholder=\"Type Text\">\n                                    Read More\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                    Artificial Intelligence\n                                </h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                    AI and machine learning algorithms are utilized in health devices to analyze large\n                                    datasets, identify patterns, and provide personalized insights\n                                </p>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                                <a href=\"\" class=\"btn item-btn btn-info\" data-app-placeholder=\"Type Text\">\n                                    Read More\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSgOZGhttA",
          "_anchor": "list02-9a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "40px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              }
            },
            ".panel-group": {
              ".card": {
                "border-radius": "0 !important",
                ".card-header": {
                  "background-color": "transparent",
                  "border": "none",
                  "border-bottom": "1px solid @border",
                  "border-radius": "0",
                  "padding": "20px",
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "width": "100%",
                    ".panel-title-edit": {
                      "margin-bottom": "0"
                    },
                    ".mbr-iconfont": {
                      "font-size": "18px",
                      "width": "18px",
                      "height": "18px",
                      "min-width": "18px",
                      "margin-bottom": "0",
                      "transition": "all 0.3s ease-in-out",
                      "color": "@icon",
                      "margin-left": "16px"
                    },
                    "&:not(.collapsed)": {
                      ".mbr-iconfont": {
                        "transform": "rotate(180deg)"
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "padding": "15px 25px",
                    ".panel-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".panel-title-edit": {
              "color": "#ffffff"
            },
            ".panel-text": {
              "color": "#ffffff"
            }
          },
          "_name": "list01",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"list01 essencem5\"\r\n        group=\"List\"\r\n        plugins=\"mbr-switch-arrow, mobirise-icons2\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <header>List</header>\r\n        <select title=\"Amount\" name=\"cardAmount\">\r\n            <option value=\"1\">1</option>\r\n            <option value=\"2\">2</option>\r\n            <option value=\"3\">3</option>\r\n            <option value=\"4\">4</option>\r\n            <option value=\"5\">5</option>\r\n            <option value=\"6\" selected>6</option>\r\n        </select>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" selected/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#dadada\" name=\"border\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#000000\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 col-lg-10\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>FAQ FOR THE ENVIRONMENTAL COMMUNITY</b>\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-10\">\r\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\"\r\n                     aria-multiselectable=\"true\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>What is the environmental community?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    The environmental community consists of individuals, organizations, and initiatives\r\n                                    dedicated to promoting environmental conservation, sustainability, and awareness. It\r\n                                    includes environmentalists, activists, scientists, and concerned citizens working\r\n                                    towards a healthier planet.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>How can I get involved in the environmental community?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    You can get involved by joining local environmental groups, volunteering for\r\n                                    environmental projects, supporting eco-friendly initiatives, and staying informed\r\n                                    about environmental issues. Attend events, participate in clean-up activities, and\r\n                                    engage with like-minded individuals.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>What are some simple actions I can take to help the environment?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    Reduce, reuse, and recycle. Conserve energy, water, and resources. Choose\r\n                                    sustainable products and practices. Plant trees, support clean energy, and minimize\r\n                                    your carbon footprint. Small individual actions collectively make a significant\r\n                                    impact.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>What is climate change, and how does it affect the environment?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    Climate change refers to long-term changes in temperature, precipitation, and other\r\n                                    atmospheric conditions on Earth. It is largely driven by human activities, such as\r\n                                    burning fossil fuels and deforestation, leading to global warming. Climate change\r\n                                    impacts include rising sea levels, extreme weather events, and threats to\r\n                                    biodiversity.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>How can I support renewable energy?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    Support policies promoting renewable energy sources like solar and wind power.\r\n                                    Invest in clean energy initiatives, use renewable energy in your home, and advocate\r\n                                    for sustainable energy practices. Being energy-efficient also contributes to\r\n                                    reducing the demand for fossil fuels.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\r\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\r\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core\r\n                               href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\r\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                    data-app-selector=\".panel-title-edit\">\r\n                                    <b>What is the importance of biodiversity?</b>\r\n                                </h4>\r\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n                             aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n                            <div class=\"panel-body\">\r\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".panel-text\">\r\n                                    Biodiversity, the variety of life on Earth, is crucial for ecosystem stability. It\r\n                                    supports ecosystem services, such as pollination, water purification, and disease\r\n                                    control. Protecting biodiversity is essential for food security, medicine, and the\r\n                                    overall health of our planet.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uSgP8EBeiY",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "list01-9c"
        },
        {
          "_name": "list2",
          "_sourceTheme": "tutorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tutorm5 list2\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons\"\r\n\tmbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\r\n\r\n\t<mbr-parameters>\r\n\t\t<header>Size</header>\r\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\r\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\r\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\r\n\t\t\tcondition=\"fullScreen == false\">\r\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\r\n\t\t\tcondition=\"fullScreen == false\">\r\n\t\t<header>Show/Hide</header>\r\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\r\n\t\t<header>Items</header>\r\n\t\t<select title=\"Amount\" name=\"cardAmount\">\r\n\t\t\t<option value=\"1\">1</option>\r\n\t\t\t<option value=\"2\">2</option>\r\n\t\t\t<option value=\"3\">3</option>\r\n\t\t\t<option value=\"4\" selected>4</option>\r\n\t\t\t<option value=\"5\" selected>5</option>\r\n\t\t</select>\r\n\t\t<input type=\"color\" title=\"Border Color\" value=\"#838383\" name=\"border\" selected>\r\n\t\t<header>Background</header>\r\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\r\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/tutorm5/components/_images/background1.jpg\" parallax>\r\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#232323\" selected>\r\n\t\t</fieldset>\r\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/tutorm5/components/_images/background1.jpg\" name=\"fallBackImage\"\r\n\t\t\tcondition=\"bg.type === 'video'\">\r\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\r\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\r\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\r\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\"\r\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\r\n\t</mbr-parameters>\r\n\r\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\r\n\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\r\n\t</div>\r\n\r\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n\t\t<div class=\"row\">\r\n\t\t\t<div class=\"col-12\">\r\n\t\t\t\t<div class=\"title-wrapper\">\r\n\t\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\"\r\n\t\t\t\t\t\tmbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n\t\t\t\t\t\tFAQ\r\n\t\t\t\t\t</h3>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\"\r\n\t\t\t\t\taria-multiselectable=\"true\">\r\n\t\t\t\t\t<div class=\"card\">\r\n\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\r\n\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t\t\t\t\tdata-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\"\r\n\t\t\t\t\t\t\t\taria-controls=\"collapse1\">\r\n\t\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".panel-title-edit, .mbr-iconfont\">What is training, and why is it\r\n\t\t\t\t\t\t\t\t\timportant?</h4>\r\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n\t\t\t\t\t\t\taria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n\t\t\t\t\t\t\t<div class=\"panel-body\">\r\n\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-4\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-text\">\r\n\t\t\t\t\t\t\t\t\tA training program is a structured and systematic approach to imparting knowledge,\r\n\t\t\t\t\t\t\t\t\tskills, and expertise to individuals or groups with a specific learning objective in\r\n\t\t\t\t\t\t\t\t\tmind. These programs are designed to enhance and refine participants' capabilities\r\n\t\t\t\t\t\t\t\t\tin a wide range of fields, from professional development to personal growth.</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 1\">\r\n\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\r\n\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t\t\t\t\tdata-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\"\r\n\t\t\t\t\t\t\t\taria-controls=\"collapse2\">\r\n\t\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".panel-title-edit, .mbr-iconfont\">How do I choose the right\r\n\t\t\t\t\t\t\t\t\ttraining program for my needs and goals?</h4>\r\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n\t\t\t\t\t\t\taria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n\t\t\t\t\t\t\t<div class=\"panel-body\">\r\n\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-4\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-text\">\r\n\t\t\t\t\t\t\t\t\tA well-planned training program typically begins with clear learning goals and\r\n\t\t\t\t\t\t\t\t\tobjectives. These objectives serve as the foundation upon which the program is\r\n\t\t\t\t\t\t\t\t\tbuilt, ensuring that participants understand what they are expected to achieve by\r\n\t\t\t\t\t\t\t\t\tthe end of the training. Next, a curriculum or syllabus is developed, outlining the\r\n\t\t\t\t\t\t\t\t\ttopics, content, and activities that will be covered during the training.\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 2\">\r\n\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingThree\">\r\n\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t\t\t\t\tdata-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\"\r\n\t\t\t\t\t\t\t\taria-controls=\"collapse3\">\r\n\t\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".panel-title-edit, .mbr-iconfont\">What are the different types of\r\n\t\t\t\t\t\t\t\t\ttraining methods available?</h4>\r\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n\t\t\t\t\t\t\taria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n\t\t\t\t\t\t\t<div class=\"panel-body\">\r\n\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-4\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-text\">\r\n\t\t\t\t\t\t\t\t\tDelivery methods can vary widely, from traditional classroom-based instruction to\r\n\t\t\t\t\t\t\t\t\tonline courses, workshops, hands-on exercises, and simulations. The choice of\r\n\t\t\t\t\t\t\t\t\tdelivery method often depends on the nature of the subject matter, the needs of the\r\n\t\t\t\t\t\t\t\t\tparticipants, and the available resources.\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 3\">\r\n\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFour\">\r\n\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t\t\t\t\tdata-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\"\r\n\t\t\t\t\t\t\t\taria-controls=\"collapse4\">\r\n\t\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".panel-title-edit, .mbr-iconfont\">What is the typical duration of\r\n\t\t\t\t\t\t\t\t\ta training program?</h4>\r\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n\t\t\t\t\t\t\taria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n\t\t\t\t\t\t\t<div class=\"panel-body\">\r\n\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-4\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-text\">\r\n\t\t\t\t\t\t\t\t\tInstructors or facilitators play a crucial role in training programs. They are\r\n\t\t\t\t\t\t\t\t\tresponsible for guiding participants through the learning process, providing\r\n\t\t\t\t\t\t\t\t\texplanations, answering questions, and offering feedback. Their expertise and\r\n\t\t\t\t\t\t\t\t\tteaching style greatly influence the effectiveness of the program.\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 4\">\r\n\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFive\">\r\n\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t\t\t\t\tdata-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\"\r\n\t\t\t\t\t\t\t\taria-controls=\"collapse5\">\r\n\t\t\t\t\t\t\t\t<h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".panel-title-edit, .mbr-iconfont\">How can I find qualified\r\n\t\t\t\t\t\t\t\t\ttrainers or instructors for my training program?</h4>\r\n\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\"\r\n\t\t\t\t\t\t\taria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\r\n\t\t\t\t\t\t\t<div class=\"panel-body\">\r\n\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-4\"\r\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-text\">\r\n\t\t\t\t\t\t\t\t\tAssessment and evaluation are integral components of any training program.\r\n\t\t\t\t\t\t\t\t\tParticipants are typically assessed to gauge their understanding and progress. This\r\n\t\t\t\t\t\t\t\t\tcan be done through quizzes, exams, practical assessments, or other means, depending\r\n\t\t\t\t\t\t\t\t\ton the program's goals. Evaluation also involves gathering feedback from\r\n\t\t\t\t\t\t\t\t\tparticipants to identify areas of improvement and make necessary adjustments to the\r\n\t\t\t\t\t\t\t\t\tprogram.\r\n\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "margin": "0",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              },
              "@media (max-width: 767px)": {
                "padding": "0 4px"
              }
            },
            ".row": {
              "margin": "0",
              ".title-wrapper": {
                ".mbr-section-title": {
                  "margin-bottom": "50px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "32px"
                  }
                }
              },
              ".panel-group": {
                ".card": {
                  "border-bottom": "1px solid @border",
                  "border-radius": "0 !important",
                  "&:first-child": {
                    "border-top": "1px solid @border"
                  },
                  ".card-header": {
                    "padding": "32px 0",
                    "border-bottom": "none",
                    "background-color": "transparent",
                    ".panel-title": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "center",
                      "&:not(.collapsed)": {
                        ".mbr-iconfont": {
                          "transform": "rotate(-45deg)"
                        }
                      },
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".mbr-iconfont": {
                        "font-size": "24px",
                        "transition": "all 0.3s ease-out"
                      }
                    }
                  },
                  ".panel-collapse": {
                    ".panel-body": {
                      "margin-bottom": "50px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "32px"
                      },
                      ".mbr-text": {
                        "margin-bottom": "50px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "32px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".panel-title-edit, .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            }
          },
          "_cid": "uSgPakEGzE",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "list2-9d"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 70px",
                "@media (max-width: 1440px)": {
                  "padding": "0 48px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".desc-wrapper": {
              ".mbr-desc": {
                "margin-bottom": "30px"
              }
            },
            ".items-wrapper": {
              ".item": {
                "border-top": "1px solid @border",
                "&:last-child": {
                  "border-bottom": "1px solid @border"
                },
                "@media (max-width: 992px)": {
                  "border": "1px solid @border",
                  "border-radius": "1.2rem !important",
                  "margin-bottom": "10px"
                },
                "a": {
                  "display": "block",
                  "&:hover, &:focus": {
                    ".item-wrapper": {
                      "&::before": {
                        "height": "100%"
                      },
                      ".card-box": {
                        ".card-number": {
                          "padding-left": "16px"
                        },
                        ".icon-wrapper": {
                          "padding-right": "16px"
                        }
                      }
                    }
                  },
                  ".item-wrapper": {
                    "position": "relative",
                    "padding": "28px 0",
                    "transition": "all 0.3s ease-in-out",
                    "@media (max-width: 992px)": {
                      "padding": "24px"
                    },
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "bottom": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "0",
                      "background-color": "@active",
                      "transition": "all 0.3s ease-in-out",
                      "@media (max-width: 1440px)": {
                        "display": "none"
                      }
                    },
                    ".card-box": {
                      "position": "relative",
                      "z-index": "1",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      ".card-number": {
                        "width": "30%",
                        "margin-bottom": "0",
                        "transition": "all 0.3s ease-in-out",
                        "@media (max-width: 992px)": {
                          "display": "none"
                        }
                      },
                      ".card-title": {
                        "width": "60%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "width": "auto"
                        }
                      },
                      ".icon-wrapper": {
                        "display": "flex",
                        "justify-content": "flex-end",
                        "width": "10%",
                        "transition": "all 0.3s ease-in-out",
                        "@media (max-width: 992px)": {
                          "width": "auto"
                        },
                        ".mbr-iconfont": {
                          "font-size": "30px",
                          "color": "@icon",
                          "@media (max-width: 992px)": {
                            "display": "flex",
                            "align-items": "center",
                            "justify-content": "center",
                            "width": "70px",
                            "height": "70px",
                            "min-width": "70px",
                            "border-radius": "100%",
                            "background-color": "@active",
                            "font-size": "22px"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-number": {
              "color": "#000000"
            }
          },
          "_name": "list01",
          "_sourceTheme": "energym5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"list01 energym5\"\r\n        group=\"List\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#dfe6ea\" name=\"border\" selected/>\r\n        <input type=\"color\" title=\"Active Color\" value=\"#FFF555\" name=\"active\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/energym5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/energym5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#000000\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.3\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"desc-wrapper\">\r\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\"\r\n                       mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                        Electric car rentals offer\r\n                    </p>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12\">\r\n                <div class=\"items-wrapper\">\r\n                    <div class=\"item features-without-image item-mb\">\r\n                        <a href=\"#\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                       mbr-if=\"showNumber\" data-app-selector=\".card-number\">\r\n                                        01\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                        mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                        Daily\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </a>\r\n                    </div>\r\n                    <div class=\"item features-without-image item-mb\">\r\n                        <a href=\"#\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                       mbr-if=\"showNumber\" data-app-selector=\".card-number\">\r\n                                        02\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                        mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                        Weekly\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </a>\r\n                    </div>\r\n                    <div class=\"item features-without-image item-mb\">\r\n                        <a href=\"#\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                       mbr-if=\"showNumber\" data-app-selector=\".card-number\">\r\n                                        03\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                        mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                        Business\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </a>\r\n                    </div>\r\n                    <div class=\"item features-without-image item-mb\">\r\n                        <a href=\"#\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                       mbr-if=\"showNumber\" data-app-selector=\".card-number\">\r\n                                        04\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                        mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                        Luxury\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uSgPcKvf5c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "list01-9e"
        },
        {
          "_name": "tabs01",
          "_sourceTheme": "resumem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"tabs01 resumem5\"\r\n        group=\"List\"\r\n        plugins=\"mbr-tabs\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Desc\" name=\"showDesc\" checked/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <header>Tabs</header>\r\n        <select title=\"Count\" name=\"bootstrapTabs\">\r\n            <option value=\"1\">1</option>\r\n            <option value=\"2\">2</option>\r\n            <option value=\"3\">3</option>\r\n            <option value=\"4\">4</option>\r\n            <option value=\"5\" selected>5</option>\r\n        </select>\r\n        <input type=\"color\" title=\"Tabs Color\" value=\"#080808\" name=\"tabs\" selected/>\r\n        <input type=\"color\" title=\"Tabs BG 1\" value=\"#00D372\" name=\"bg_1\" selected/>\r\n        <input type=\"color\" title=\"Tabs BG 2\" value=\"#56ACFF\" name=\"bg_2\" selected/>\r\n        <input type=\"color\" title=\"Tabs BG 3\" value=\"#7179EF\" name=\"bg_3\" selected/>\r\n        <input type=\"color\" title=\"Tabs BG 4\" value=\"#e26a69\" name=\"bg_4\" selected/>\r\n        <input type=\"color\" title=\"Shadow Color\" value=\"#333333\" name=\"shadow\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#f0f0f0\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#f0f0f0\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n            <div class=\"col-12\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .tabs-wrap\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        Types of projects\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-5\">\r\n                <div class=\"tabs-wrap\">\r\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\r\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\"\r\n                               aria-selected=\"true\">\r\n                                Corporate\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                E-commerce\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab3\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Personal\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Content\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab5\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Social\r\n                            </a>\r\n                        </li>\r\n                    </ul>\r\n                   <div class=\"desc-wrapper\">\r\n                       <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\"\r\n                           mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                           Remember to provide context for each project\r\n                       </p>\r\n                       <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                            mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                           <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                               <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\r\n                               View all\r\n                           </a>\r\n                       </div>\r\n                   </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-6\">\r\n                <div class=\"tab-content\">\r\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\r\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                            <div class=\"image-wrapper\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image10.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".card-text\">\r\n                                    Showcase a website designed for a corporate client. Highlight features such as a\r\n                                    clean and professional layout, easy navigation, and integration of the company's\r\n                                    branding elements.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\r\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                            <div class=\"image-wrapper\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image13.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".card-text\">\r\n                                    Display an e-commerce website you've designed, emphasizing user-friendly product\r\n                                    pages, secure checkout processes, and effective product categorization.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\r\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                            <div class=\"image-wrapper\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image7.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".card-text\">\r\n                                    Include your own portfolio or personal website to showcase your design skills. This\r\n                                    demonstrates your ability to brand yourself and create a visually appealing online\r\n                                    presence.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\r\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                            <div class=\"image-wrapper\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image19.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".card-text\">\r\n                                    Feature a blog or content-based website in your portfolio to showcase your ability\r\n                                    to create engaging layouts, readable typography, and effective content organization.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\r\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                            <div class=\"image-wrapper\">\r\n                                <img src=\"@PROJECT_PATH@/assets/images/image14.webp\" alt=\"Mobirise\">\r\n                            </div>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                   data-app-selector=\".card-text\">\r\n                                    Highlight a project where you integrated social media elements effectively. Showcase\r\n                                    how social media feeds, sharing options, or login features were seamlessly\r\n                                    incorporated.\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 1440px)": {
                  "padding": "0 36px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".title-wrapper": {
              "position": "sticky",
              ".mbr-section-title": {
                "margin-bottom": "48px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "36px"
                }
              }
            },
            ".tabs-wrap": {
              "display": "flex",
              "flex-direction": "column",
              "height": "100%",
              "justify-content": "space-between",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px",
                "height": "auto"
              },
              ".nav.nav-tabs": {
                "display": "inline-flex",
                "flex-wrap": "wrap",
                "border": "none",
                ".nav-item": {
                  "padding": "0",
                  "border": "none",
                  "margin": "0 16px 16px 0",
                  "&:last-child": {
                    "margin-right": "0"
                  },
                  ".nav-link": {
                    "margin-bottom": "0",
                    "color": "@tabs",
                    "padding": "15px 30px",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "border": "4px solid @tabs",
                    "border-radius": "100em !important",
                    "background-color": "transparent",
                    "position": "relative",
                    "transition": "all .3s ease",
                    "z-index": "11",
                    "&::after": {
                      "content": "''",
                      "position": "absolute",
                      "width": "100%",
                      "height": "100%",
                      "background-image": "linear-gradient(135deg, @bg_1, @bg_2 34%, @bg_3 67%, @bg_4) !important",
                      "border-radius": "100em",
                      "z-index": "-1",
                      "opacity": "0",
                      "pointer-events": "none",
                      "transition": "all 0.3s ease-in-out"
                    }
                  },
                  ".nav-link.active": {
                    "&::after": {
                      "opacity": "1"
                    }
                  }
                }
              },
              ".desc-wrapper": {
                ".mbr-desc": {
                  "margin-top": "32px"
                },
                ".mbr-section-btn": {
                  "margin-top": "22px"
                }
              }
            },
            ".content-wrapper": {
              ".image-wrapper": {
                "margin-bottom": "36px",
                "img": {
                  "height": "450px",
                  "object-fit": "cover",
                  "border-radius": ".5em !important",
                  "box-shadow": "0 7px 20px @shadow",
                  "@media (max-width: 768px)": {
                    "height": "350px"
                  }
                }
              },
              ".text-wrapper": {
                ".card-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#080808"
            },
            ".mbr-desc": {
              "color": "#333333"
            },
            ".card-text": {
              "color": "#333333"
            }
          },
          "_cid": "uSgPfda0lc",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "tabs01-9f"
        },
        {
          "_name": "tabs01",
          "_sourceTheme": "divem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"tabs01 divem5\"\r\n        group=\"List\"\r\n        plugins=\"mbr-tabs\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Tabs</header>\r\n        <select title=\"Count\" name=\"bootstrapTabs\">\r\n            <option value=\"1\">1</option>\r\n            <option value=\"2\">2</option>\r\n            <option value=\"3\">3</option>\r\n            <option value=\"4\" selected>4</option>\r\n        </select>\r\n        <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected/>\r\n        <input type=\"color\" title=\"Tabs Bg\" value=\"#ffffff\" name=\"tabsBg\" selected/>\r\n        <input type=\"color\" title=\"Active BG\" value=\"#EF6F3F\" name=\"activeBg\" selected/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#e1e1e1\" name=\"border\" selected/>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@PROJECT_PATH@/assets/images/background1.webp\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.3\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"tab-content\">\r\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\r\n                        <div class=\"content-wrap\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/background1.webp\" alt=\"Mobirise\">\r\n                            <div class=\"title-wrap\">\r\n                                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                    data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                                    mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                    <b>THE MOST ICONIC AND CHALLENGING WAVES</b>\r\n                                </h2>\r\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                     mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                       data-app-placeholder=\"Type Text\">\r\n                                        SEE MORE\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\r\n                        <div class=\"content-wrap\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/background4.webp\" alt=\"Mobirise\">\r\n                            <div class=\"title-wrap\">\r\n                                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                    data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                                    mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                    <b>SHALLOW <br> REEF</b>\r\n                                </h2>\r\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                     mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                       data-app-placeholder=\"Type Text\">\r\n                                        SEE MORE\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\r\n                        <div class=\"content-wrap\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/background2.webp\" alt=\"Mobirise\">\r\n                            <div class=\"title-wrap\">\r\n                                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                    data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                                    mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                    <b>RIGHT-HAND <br> WAVES</b>\r\n                                </h2>\r\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                     mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                       data-app-placeholder=\"Type Text\">\r\n                                        SEE MORE\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\r\n                        <div class=\"content-wrap\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/background5.webp\" alt=\"Mobirise\">\r\n                            <div class=\"title-wrap\">\r\n                                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                    data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                                    mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                    <b>WORLD-CLASS <br> WAVES</b>\r\n                                </h2>\r\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                     mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                       data-app-placeholder=\"Type Text\">\r\n                                        SEE MORE\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12\">\r\n                <div class=\"tabs-wrapper\">\r\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\r\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\"\r\n                               aria-selected=\"true\">\r\n                                Pipeline, Oahu\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Banzai Pipeline\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab3\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Jeffreys Bay\r\n                            </a>\r\n                        </li>\r\n                        <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\"\r\n                            data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\r\n                            <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\"\r\n                               data-app-placeholder=\"Type Text\" aria-selected=\"true\">\r\n                                Uluwatu, Bali\r\n                            </a>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "0 25px"
              }
            },
            ".tab-content": {
              ".tab-pane": {
                ".content-wrap": {
                  "padding": "10% 5% 15%",
                  "position": "relative",
                  "@media (max-width: 1199px)": {
                    "padding": "10% 5% 25%"
                  },
                  "@media (max-width: 992px)": {
                    "padding": "100px 25px"
                  },
                  "img": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "object-fit": "cover"
                  },
                  ".title-wrap": {
                    "position": "relative",
                    "z-index": "1",
                    ".mbr-section-title": {
                      "margin-bottom": "50px"
                    }
                  }
                }
              }
            },
            ".tabs-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "margin-top": "-110px",
              "@media (max-width: 1199px)": {
                "margin-top": "-220px"
              },
              "@media (max-width: 992px)": {
                "display": "block",
                "margin": "0"
              },
              ".nav.nav-tabs": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr 1fr",
                "border": "none",
                "@media (max-width: 1199px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".nav-item": {
                  "display": "flex",
                  "align-items": "center",
                  "padding": "0",
                  "position": "relative",
                  "&:hover, &:focus": {
                    "&::after": {
                      "display": "none"
                    }
                  },
                  "&::after": {
                    "content": "''",
                    "position": "absolute",
                    "right": "-1px",
                    "height": "65%",
                    "width": "2px",
                    "background-color": "@border",
                    "@media (max-width: 992px)": {
                      "display": "none"
                    }
                  },
                  "&:last-child": {
                    "&::after": {
                      "display": "none"
                    }
                  },
                  "@media (max-width: 1199px)": {
                    "&:nth-child(2)": {
                      "&::after": {
                        "display": "none"
                      }
                    }
                  },
                  ".nav-link": {
                    "width": "100%",
                    "margin-bottom": "0",
                    "border": "none",
                    "color": "@tabs",
                    "background-color": "@tabsBg",
                    "border-radius": "0 !important",
                    "padding": "40px 52px",
                    "transition": "all 0.3s ease-in-out",
                    "@media (max-width: 992px)": {
                      "padding": "25px",
                      "text-align": "center"
                    }
                  },
                  ".nav-link.active": {
                    "background-color": "@activeBg",
                    "color": "@tabsBg"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            }
          },
          "_cid": "uSgPq0yEuJ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "tabs01-9g"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "35px"
                }
              }
            },
            ".item": {
              "margin-bottom": "35px",
              "justify-content": "space-between",
              "&:hover, &:focus": {
                ".item-wrapper .item-img img": {
                  "transform": "scale(1.1)"
                }
              },
              ".item-wrapper": {
                "justify-content": "space-between",
                "height": "100%",
                ".item-wrap": {
                  ".item-img": {
                    "margin-bottom": "30px",
                    "border-radius": "2rem !important",
                    "overflow": "hidden",
                    "& when not (@isRoundedImages)": {
                      "border-radius": "0 !important"
                    },
                    "img": {
                      "border-radius": "2rem",
                      "object-fit": "cover",
                      "height": "250px",
                      "transition": "all 0.5s ease-in-out"
                    }
                  },
                  ".item-content": {
                    ".item-price": {
                      "margin-bottom": "30px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "15px"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "15px"
                    },
                    ".item-text": {
                      "margin-bottom": "10px"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-price": {
              "color": "#000000"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            }
          },
          "_name": "pricing01",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"pricing01 ridem5\"\r\n        group=\"Pricing\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/ridem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#E9E9E6\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@ADDONS_PATH@/ridem5/components/_images/background1.jpg\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>Prices in The Bike Store</b>\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-image col-12 col-lg-4 item-mb\">\r\n                <div class=\"item-wrapper card\">\r\n                    <div class=\"item-wrap\">\r\n                        <div class=\"item-img\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/image12.webp\" alt=\"Mobirise\">\r\n                        </div>\r\n                        <div class=\"item-content\">\r\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                               data-app-selector=\".item-price\">\r\n                                <b>$1,499</b>\r\n                            </p>\r\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"\r\n                                data-app-selector=\".item-title, .mbr-section-btn\">\r\n                                <b>EcoCruise E1</b>\r\n                            </h4>\r\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".item-text\">\r\n                                The EcoCruise E1 is an entry-level electric bike designed for urban commuting and\r\n                                recreational riding.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\r\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            BUY NOW\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-image col-12 col-lg-4 item-mb\">\r\n                <div class=\"item-wrapper card\">\r\n                    <div class=\"item-wrap\">\r\n                        <div class=\"item-img\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/image10.webp\" alt=\"Mobirise\">\r\n                        </div>\r\n                        <div class=\"item-content\">\r\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                               data-app-selector=\".item-price\">\r\n                                <b>$2,499</b>\r\n                            </p>\r\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"\r\n                                data-app-selector=\".item-title, .mbr-section-btn\">\r\n                                <b>Trek Verve+ 2</b>\r\n                            </h4>\r\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".item-text\">\r\n                                The Trek Verve+ 2 is a mid-range electric bike ideal for riders seeking versatility and\r\n                                comfort.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\r\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            BUY NOW\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-image col-12 col-lg-4 item-mb\">\r\n                <div class=\"item-wrapper card\">\r\n                    <div class=\"item-wrap\">\r\n                        <div class=\"item-img\">\r\n                            <img src=\"@PROJECT_PATH@/assets/images/image22.webp\" alt=\"Mobirise\">\r\n                        </div>\r\n                        <div class=\"item-content\">\r\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                               data-app-selector=\".item-price\">\r\n                                <b>$3,499</b>\r\n                            </p>\r\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"\r\n                                data-app-selector=\".item-title, .mbr-section-btn\">\r\n                                <b>Turbo Vado SL</b>\r\n                            </h4>\r\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".item-text\">\r\n                                Turbo Vado SL is a premium electric bike designed for discerning riders who demand the best\r\n                                in performance.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\r\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            BUY NOW\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uSgPKk2vuZ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "pricing01-9h"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".title-section": {
              "padding": "0px",
              "margin-bottom": "20px"
            },
            "@media (min-width: 992px)": {
              ".title-section": {
                "padding": "0 90px",
                "margin-bottom": "40px"
              }
            },
            ".btn": {
              "display": "flex"
            },
            ".card": {
              "background-color": "if(@isTransparent, transparent, @cardColor)",
              "& when (@hasShadow)": {
                "box-shadow": "0px 10px 20px 0px rgba(29, 29, 27, 0.2)"
              }
            },
            ".card-body": {
              "padding": "40px 55px 30px 55px"
            },
            ".col-img": {
              "width": "35px",
              "height": "35px",
              "flex": "0 0 35px",
              "margin-right": "22px"
            },
            ".card-title": {
              "flex": "1 1 auto",
              "width": "auto"
            },
            ".price": {
              "text-align": "left"
            },
            ".title-section .mbr-section-subtitle": {
              "text-align": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "pricing02",
          "_sourceTheme": "preschoolm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing02\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\"\n            condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\"\n            condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header condition=\"cardAmount != 3\">Row</header>\n        <select condition=\"cardAmount != 3\" title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Amount\" name=\"cardAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"isTransparent\" checked>\n        <input type=\"color\" title=\"Color\" name=\"cardColor\" value=\"#ffffff\" condition=\"!isTransparent\">\n        <input type=\"checkbox\" title=\"Shadow\" name=\"hasShadow\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/preschoolm5/components/_images/bg/1-bg.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/preschoolm5/components/_images/bg/1-bg.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n        bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row title-section\" mbr-if=\"showTitle || showSubtitle\">\n                <h2 class=\"mbr-section-title mbr-fonts-style col-12 col-md-6 mb-4\" mbr-theme-style=\"display-2\"\n                    data-app-selector=\".title-section .mbr-section-title\" data-app-placeholder=\"Type Text\"\n                    mbr-if=\"showTitle\">\n                    <b>Kindergarten</b>\n                </h2>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style col-12 col-md-6\" mbr-theme-style=\"display-5\"\n                    data-app-selector=\".title-section .mbr-section-subtitle\" data-app-placeholder=\"Type Text\"\n                    mbr-if=\"showSubtitle\">\n                    <b>Morbi et bibendum nibh.</b>\n                </h3>\n            </div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-lg-4\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"@PROJECT_PATH@/assets/images/green.svg\" alt=\"Mobirise\" class=\"col-img\"\n                                    mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\"\n                                    mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\"\n                                    data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\">\n                                    <b>Basic</b>\n                                </h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\"\n                                data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                                Morbi gravida lectus in vehicula placerat. Phasellus eget magna leo. Orci varius natoque\n                                penatibus et magnis dis parturient montes, nascetur ridiculus mus. Morbi a euismod\n                                velit.\n                            </p>\n                            <p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\"\n                                data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\">\n                                <b>$199 per month</b>\n                            </p>\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\"\n                                mbr-if=\"showButton\">\n                                <a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Type Text\">\n                                    ENROLL CHILD\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-4\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"@PROJECT_PATH@/assets/images/cyan.svg\" alt=\"Mobirise\" class=\"col-img\"\n                                    mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\"\n                                    mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\"\n                                    data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\">\n                                    <b>Standard</b>\n                                </h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\"\n                                data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                                Praesent semper arcu ut massa eleifend sodales. Integer vestibulum sapien et malesuada\n                                convallis. Aenean hendrerit lorem nec mauris rhoncus, in placerat tellus tincidunt. Sed\n                                et faucibus dui, vel congue erat.\n                            </p>\n                            <p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\"\n                                data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\">\n                                <b>$350 per month</b>\n                            </p>\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\"\n                                mbr-if=\"showButton\">\n                                <a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Type Text\">\n                                    ENROLL CHILD\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-4\" mbr-if=\"cardAmount > 2\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <div class=\"mb-3 d-flex align-items-center\">\n                                <img src=\"@PROJECT_PATH@/assets/images/purple.svg\" alt=\"Mobirise\" class=\"col-img\"\n                                    mbr-if=\"showIcon\">\n                                <h4 class=\"card-title mbr-section-subtitle mbr-fonts-style m-0\"\n                                    mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\"\n                                    data-app-placeholder=\"Type Text\" mbr-if=\"showCardTitle\">\n                                    <b>Premium</b>\n                                </h4>\n                            </div>\n                            <p class=\"mbr-text text1 mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\"\n                                data-app-selector=\".text1\" data-app-placeholder=\"Type Text\" mbr-if=\"showText\">\n                                Suspendisse non diam nisl. Vivamus vehicula dolor sit amet augue malesuada porta.\n                                Phasellus massa nibh, tristique id eros vitae, interdum suscipit ligula. Morbi ante\n                                ligula, efficitur lobortis faucibus eu, luctus et enim.\n                            </p>\n                            <p class=\"mbr-text price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\"\n                                data-app-selector=\".price\" data-app-placeholder=\"Type Text\" mbr-if=\"showPrice\">\n                                <b>$500 per month</b>\n                            </p>\n                            <div class=\"mbr-section-btn mb-3\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\"\n                                mbr-if=\"showButton\">\n                                <a class=\"btn btn-primary justify-content-center\" data-app-placeholder=\"Type Text\">\n                                    ENROLL CHILD\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSgQbtRNmW",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "pricing02-9i"
        },
        {
          "_name": "apricing1",
          "_sourceTheme": "cyberm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing1\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Card BG\" name=\"BgCard\" checked>\n        <input type=\"color\" title=\"Card BG Color\" name=\"cardColor\" value=\"#ffffff\" condition=\"BgCard\">\n        <input type=\"color\" title=\"Card Premium BG Color\" name=\"cardColor2\" value=\"#0066FF\" condition=\"BgCard\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background6.webp\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/cyberm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showMainTitle || showLabel\">\n            <div class=\"col-12 col-xl-7 col-lg-6 col-md-8 m-auto\">\n                <p class=\"label-text mbr-fonts-style align-center\"  mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".label-text\">\n                    <span>PRICING & PLAN</span>\n                </p>\n                <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\"\n                    mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    No Hidden Cost. Choose your plan.\n                </h4>\n            </div>\n        </div>\n        <div class=\"row\" mbr-if=\"showTitle || showPrice || showText || showButtons\">\n            <div class=\"cards-container col-12 col-xxl-10 m-auto\">\n                <div class=\"row cards-row\">\n                    <div class=\"col-12 col-lg-4 col-sm-6 col-card\">\n                        <div class=\"card-wrapper card-1\" mbr-if=\"showTitle || showPrice || showText || showButtons\">\n                            <div class=\"card-box align-left\">\n                                <h4 class=\"card-title mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"\n                                    data-app-selector=\".card-title\">\n                                    Standard\n                                </h4>\n                                <div class=\"price-container\" mbr-if=\"showPrice\">\n                                    <p class=\"symbol-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                       data-app-selector=\".symbol-text\">\n                                        <b>$</b>\n                                    </p>\n                                    <p class=\"price-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                                       data-app-selector=\".price-text\">\n                                        0\n                                    </p>\n                                </div>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    1 Domain\n                                </p>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    1 Year Premium Support\n                                </p>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    Team fundraising\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"\n                                     data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\n                                                                   data-app-placeholder=\"Type Text\">Choose Plan</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"col-12 col-lg-4 col-sm-6 col-card\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"card-wrapper card-2\" mbr-if=\"showTitle || showPrice || showText || showButtons\">\n                            <div class=\"card-box align-left\">\n                                <h4 class=\"card-title2 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"\n                                    data-app-selector=\".card-title2\">\n                                    Standard\n                                </h4>\n                                <div class=\"price-container\" mbr-if=\"showPrice\">\n                                    <p class=\"symbol-text2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                       data-app-selector=\".symbol-text2\">\n                                        <b>$</b>\n                                    </p>\n                                    <p class=\"price-text2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                                       data-app-selector=\".price-text2\">\n                                        39.\n                                    </p>\n                                    <p class=\"price-share-text2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                       data-app-selector=\".price-share-text2\">\n                                        <b>99</b>\n                                    </p>\n                                </div>\n                                <p class=\"mbr-text2 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text2\">\n                                    1 Domain\n                                </p>\n                                <p class=\"mbr-text2 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text2\">\n                                    1 Year Premium Support\n                                </p>\n                                <p class=\"mbr-text2 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text2\">\n                                    Team fundraising\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"\n                                     data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"https://mobiri.se\"\n                                                                   data-app-placeholder=\"Type Text\">Choose Plan</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"col-12 col-lg-4 col-sm-6 col-card\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"card-wrapper card-3\" mbr-if=\"showTitle || showPrice || showText || showButtons\">\n                            <div class=\"card-box align-left\">\n                                <h4 class=\"card-title mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"\n                                    data-app-selector=\".card-title\">\n                                    Standard\n                                </h4>\n                                <div class=\"price-container\" mbr-if=\"showPrice\">\n                                    <p class=\"symbol-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                       data-app-selector=\".symbol-text\">\n                                        <b>$</b>\n                                    </p>\n                                    <p class=\"price-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                                       data-app-selector=\".price-text\">\n                                        27.\n                                    </p>\n                                    <p class=\"price-share-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                       data-app-selector=\".price-share-text\">\n                                        <b>99</b>\n                                    </p>\n                                </div>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    1 Domain\n                                </p>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    1 Year Premium Support\n                                </p>\n                                <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                   data-app-selector=\".mbr-text\">\n                                    Team fundraising\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"\n                                     data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\n                                                                   data-app-placeholder=\"Type Text\">Choose Plan</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mbr-section-subtitle\" mbr-if=\"showMainSubtitle\">\n            <div class=\"col-12 col-xxl-5 col-xl-6 col-lg-7 m-auto\">\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center\" mbr-theme-style=\"display-7\"\n                    mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Excepteur sint occaecat cupidatat non proident,\n                    sunt in culpa qui officia deserunt mollit.\n                </h5>\n            </div>\n        </div>\n    </div>\n</section>",
